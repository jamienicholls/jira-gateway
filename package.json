{
  "name": "jira-gateway",
  "version": "1.0.0",
  "description": "Azure Function App REST wrapper over the Jira API — an agentic development PoC",
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "func start",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@azure/functions": "4.16.2",
    "axios": "1.19.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"],
    "collectCoverageFrom": ["src/**/*.ts", "!src/**/*.test.ts"]
  },
  "overrides": {
    "glob": {
      "minimatch": {
        "brace-expansion": "^2.1.4"
      }
    },
    "test-exclude": {
      "minimatch": {
        "brace-expansion": "^1.1.18"
      }
    }
  }
}
