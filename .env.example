# .env.example — documents the environment variables this app needs.
#
# Local dev uses TWO files (both gitignored):
#   1. local.settings.json — read by the Functions runtime (func start).
#      Copy these values into its "Values" section.
#   2. .env — read by the VS Code REST Client for test.http ({{$dotenv API_KEY}}).
#      Only API_KEY is needed there.
#
# Never commit local.settings.json or .env — this repo is public.

JIRA_BASE_URL=https://yoursite.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your-jira-api-token
API_KEY=your-chosen-gateway-api-key
